# Copy to .env and fill in for your environment.

# Signs session tokens — set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of emails that get HR/admin access on login.
ADMIN_EMAILS=hr@carsu.edu.ph

# Optional: restrict who can log in at all (leave blank to allow any email).
ALLOWED_EMAIL_DOMAIN=carsu.edu.ph
